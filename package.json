{
  "name": "dsh-plugin-suite",
  "version": "0.1.0",
  "description": "Five DSH plugins in one install: password lock, settings pages for host environment variables, host identity inspection, process restart with autostart, and archived-session management.",
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixpu/dsh-suite.git"
  },
  "homepage": "https://github.com/felixpu/dsh-suite#readme",
  "bugs": {
    "url": "https://github.com/felixpu/dsh-suite/issues"
  },
  "author": "felixpu",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-lock": "^0.1.3",
    "dsh-settings-params": "^0.1.0",
    "dsh-env-inspector-plus": "^0.1.5",
    "dsh-restart-autostart": "^0.2.2",
    "dsh-archive-session-manager": "^0.1.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "suite",
    "bundle",
    "aggregator"
  ],
  "license": "MIT"
}
